{
    "name": "borko-andy/nc-werbung-contao-ai-alt-text-bundle",
    "description": "NC-Werbung AI Alt-Text Generator for Contao CMS",
    "type": "contao-bundle",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "NC Werbung",
            "homepage": "https://www.nc-werbung.at"
        }
    ],
    "require": {
        "php": "^8.1",
        "contao/core-bundle": "^5.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0"
    },
    "conflict": {
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "autoload": {
        "psr-4": {
            "NcWerbung\\ContaoAiAltTextBundle\\": "src/"
        }
    },
    "extra": {
        "contao-manager-plugin": "NcWerbung\\ContaoAiAltTextBundle\\ContaoManager\\Plugin"
    }
}
